{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.config/agents/agent-status.sh working" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "~/.config/agents/agent-status.sh pretool" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.config/agents/agent-status.sh needs_input" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/.config/agents/agent-status.sh done" } ] }
    ]
  }
}
