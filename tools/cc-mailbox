#!/usr/bin/env python3
"""Claude-native cross-agent messaging: a mailbox per Claude session.

A message goes into a running Claude session through its own messaging
socket, as a queued user message. It never becomes keystrokes, so it does
not touch a half-typed prompt and does not commit on Enter. This is the
delivery primitive under Claude Code's own peer messaging; a shim inside a
session registers its mailbox, and any agent (local or over a tmux2 link)
delivers to it by session id.

Subcommands:
  register   From inside a Claude session (a SessionStart hook): record
             this session's socket and token so others can reach it.
  send       Deliver a user message to a session id (or an explicit
             --socket/--token).
  list       Show the registered mailboxes on this machine.

The registry is per machine, under $XDG_RUNTIME_DIR/cc-mailboxes. A token
grants delivery into that session, so the files are mode 0600 and the
directory 0700. Cross-machine delivery runs `send` on the target machine,
reached through the tmux2 plugin bridge or ssh; the token never leaves the
machine that owns the session.
"""
import argparse, json, os, socket, sys, time

def reg_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    d = os.path.join(base, "cc-mailboxes")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d

def deliver(sock_path, token, text, timeout=5.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(sock_path)
    auth = json.dumps({"type": "auth", "token": token}) + "\n"
    msg = json.dumps({"type": "user",
                      "message": {"role": "user", "content": text}}) + "\n"
    s.sendall(auth.encode())
    s.sendall(msg.encode())
    s.settimeout(timeout)
    reply = b""
    try:
        while b"\n" not in reply:
            chunk = s.recv(4096)
            if not chunk:
                break
            reply += chunk
    except socket.timeout:
        pass
    s.close()
    return reply.decode(errors="replace").strip()

def cmd_register(args):
    sid = args.session or os.environ.get("CLAUDE_CODE_SESSION_ID")
    sock_path = args.socket or os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET")
    token = args.token or os.environ.get("CLAUDE_CODE_MESSAGING_TOKEN")
    if not (sid and sock_path and token):
        sys.exit("register: need CLAUDE_CODE_SESSION_ID, "
                 "CLAUDE_CODE_MESSAGING_SOCKET and _TOKEN in the environment "
                 "(run this as a hook inside a Claude session)")
    rec = {"session": sid, "socket": sock_path, "token": token,
           "pane": os.environ.get("TMUX_PANE", ""),
           "host": socket.gethostname(), "updated": int(time.time())}
    path = os.path.join(reg_dir(), sid + ".json")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(rec, f)
    print(sid)

def load(sid):
    path = os.path.join(reg_dir(), sid + ".json")
    if not os.path.exists(path):
        sys.exit(f"send: no mailbox for session {sid}")
    with open(path) as f:
        return json.load(f)

def cmd_send(args):
    text = args.message if args.message is not None else sys.stdin.read()
    if args.socket and args.token:
        sock_path, token = args.socket, args.token
    else:
        rec = load(args.session)
        sock_path, token = rec["socket"], rec["token"]
    try:
        reply = deliver(sock_path, token, text)
    except OSError as e:
        sys.exit(f"send: {sock_path}: {e}")
    if not reply:
        sys.exit("send: no reply from the session (socket gone?)")
    try:
        obj = json.loads(reply.splitlines()[0])
    except ValueError:
        sys.exit(f"send: unexpected reply: {reply[:200]}")
    if obj.get("delivered") or obj.get("type") == "delivered":
        print("delivered")
        return
    sys.exit(f"send: not delivered: {reply[:200]}")

def cmd_list(args):
    d = reg_dir()
    for name in sorted(os.listdir(d)):
        if not name.endswith(".json"):
            continue
        with open(os.path.join(d, name)) as f:
            rec = json.load(f)
        age = int(time.time()) - rec.get("updated", 0)
        print(f"{rec['session']}\t{rec.get('host','')}\t"
              f"{rec.get('pane','')}\t{age}s ago")

def main():
    p = argparse.ArgumentParser(description="Claude session mailboxes")
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("register"); r.set_defaults(fn=cmd_register)
    r.add_argument("--session"); r.add_argument("--socket"); r.add_argument("--token")
    s = sub.add_parser("send"); s.set_defaults(fn=cmd_send)
    s.add_argument("session", nargs="?")
    s.add_argument("-m", "--message")
    s.add_argument("--socket"); s.add_argument("--token")
    l = sub.add_parser("list"); l.set_defaults(fn=cmd_list)
    args = p.parse_args()
    args.fn(args)

if __name__ == "__main__":
    main()
